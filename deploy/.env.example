# Copy to deploy/.env for local Compose runs, or store the same content as
# Jenkins Secret file with credentials ID: kolog-be-env.

# External PostgreSQL datasource
DB_URL=jdbc:postgresql://your-db-host:5432/kolog
DB_USERNAME=kolog
DB_PASSWORD=change-me-db-password

JWT_SECRET=change-me-jwt-secret

FILE_UPLOAD_DIR=/app/storage/
FILE_SERVER_URL=http://localhost:8001

# 브라우저에서 API 를 호출하는 프론트엔드 Origin 목록(콤마 구분, 스킴+호스트+포트 정확히).
# 여기에 없는 Origin 에서 온 요청은 인가 단계 이전에 CorsFilter 가 403 "Invalid CORS request" 로 잘라낸다.
# 미설정 시 application.properties 기본값인 http://localhost:3000 만 허용된다.
CORS_ALLOWED_ORIGINS=http://localhost:3000
