# Store these keys as a Jenkins Secret file credential named `kolog-be-env`.
# Never commit deploy/.env. Values below are examples only.

# Deployment settings (non-secret)
APP_PORT=8001
FILE_UPLOAD_DIR=/app/storage/
FILE_SERVER_URL=http://your-deployment-host:8001
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
JPA_SHOW_SQL=false
HIBERNATE_FORMAT_SQL=false
HIBERNATE_HIGHLIGHT_SQL=false

# External PostgreSQL (DB_PASSWORD is secret)
DB_URL=jdbc:postgresql://your-db-host:5432/kolog
DB_USERNAME=kolog
DB_PASSWORD=replace-with-secret

# Authentication secret; use a strong value of at least 32 bytes
JWT_SECRET=replace-with-strong-secret

# IMAGE_TAG is supplied by Jenkins as BUILD_NUMBER-shortCommitSha.
# For local validation only, export an immutable test value such as:
# IMAGE_TAG=local-$(git rev-parse --short=12 HEAD)
