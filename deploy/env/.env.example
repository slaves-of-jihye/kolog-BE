# docker compose가 자동으로 읽는 위치(compose 파일과 같은 디렉터리)가 아니라
# external/env/ 로 분리되어 있으므로, external/build/ 에 이 파일을 가리키는
# .env symlink를 심어 자동 로드되게 해뒀다 (플래그 불필요).
# docker-compose.yml 안의 ${VAR} 자리를 채우는 compose 파싱 시점 치환 전용이며,
# 컨테이너 안으로 직접 들어가지 않는다. compose 외부(호스트) 관점의 값만 여기 둔다.

# 호스트에 노출할 app 포트
APP_PORT=8080
