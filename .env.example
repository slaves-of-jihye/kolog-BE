# Copy to .env at the project root for Compose, or use Jenkins Secret file kolog-be-env.
# Run from the project root: docker compose --env-file .env -f deploy/docker-compose.yml up -d
# For direct local execution, use localhost in DB_URL and a local FILE_SYSTEM_PATH.
DB_URL=jdbc:postgresql://db:5432/kolog
DB_USERNAME=kolog
DB_PASSWORD=change-me-db-password

JWT_ACCESS_SECRET=change-me-access-secret-must-be-at-least-32-bytes
JWT_REFRESH_SECRET=change-me-refresh-secret-must-be-at-least-32-bytes

FILE_SYSTEM_PATH=/app/storage/
APP_URL=http://localhost:8001

CORS_ALLOWED_ORIGINS=http://localhost:3000
