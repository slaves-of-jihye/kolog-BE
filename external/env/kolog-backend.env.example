# kolog-backend(app) 컨테이너 전용 환경변수. compose.yml의 `env_file:`로 그대로
# 컨테이너 프로세스 환경에 주입됨 (compose 변수 치환이 아니라 컨테이너 런타임 주입).
# db.env의 POSTGRES_DB/POSTGRES_USER/POSTGRES_PASSWORD와 값이 일치해야 접속 가능.

DB_URL=jdbc:postgresql://db:5432/kolog
DB_USERNAME=kolog
DB_PASSWORD=change-me

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

FILE_UPLOAD_DIR=/app/uploads
FILE_SERVER_URL=http://localhost:8080

APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
